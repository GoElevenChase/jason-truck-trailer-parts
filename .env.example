# Public, build-time settings. Copy to .env.local for local development.
# Never put private keys, passwords, service-role tokens, or server secrets here.
# Rebuild after changing a value; static files do not read environment changes.

# preview: chooser at / and both design routes available.
# production: selected design at /; preview routes excluded from export.
NEXT_PUBLIC_SITE_MODE=preview

# Valid values: design-1 (Open Studio), design-2 (Midnight Systems).
NEXT_PUBLIC_SELECTED_DESIGN=design-1

# Local URL is appropriate for development.
# Production requires the real public HTTPS origin, without a path or query.
# Local, example, and placeholder destinations are not production URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# email: opens a draft in the visitor's email application; it does not send.
# external: POSTs JSON to the configured endpoint and requires {"ok":true}.
NEXT_PUBLIC_CONTACT_MODE=email

# Required for external mode. Use a real public HTTPS endpoint.
# The receiving service owns validation, anti-spam, rate limits, and delivery.
# Leave blank in email mode. This URL is public; it must contain no secrets.
NEXT_PUBLIC_CONTACT_ENDPOINT=
